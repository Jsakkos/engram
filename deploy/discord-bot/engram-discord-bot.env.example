# --- Secrets ---------------------------------------------------------------
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# GitHub App (preferred). Put the app's private key next to docker-compose.yml
# as github-app.pem; the compose file mounts it.
GITHUB_APP_ID=
# Or, instead of an app, a fine-grained token with Issues: read & write on the repo:
# GITHUB_TOKEN=

# --- Discord wiring (enable Developer Mode, right-click -> Copy ID) ---------
DISCORD_GUILD_ID=
DISCORD_HELP_FORUM_ID=
DISCORD_MAINTAINER_ROLE_ID=
# Optional: a private channel that gets a line for every issue the bot files.
DISCORD_MAINTAINER_LOG_CHANNEL_ID=
# How the bot refers to you ("the maintainer" if unset).
MAINTAINER_NAME=

# --- Optional tuning (defaults shown) --------------------------------------
# GITHUB_REPO=Jsakkos/engram
# BOT_MODEL=claude-haiku-5-5
# BOT_EFFORT=medium
# BOT_DAILY_BUDGET_USD=2.0
# BOT_MAX_ISSUES_PER_USER_PER_DAY=3
# BOT_MAX_TURNS_PER_USER_PER_HOUR=30
# BOT_MIN_ACCOUNT_AGE_DAYS=7
# BOT_ALLOWED_LABELS=bug,enhancement,documentation,ux,question,linux,docker
# BOT_KNOWLEDGE_REFRESH_HOURS=6
# LOG_LEVEL=INFO

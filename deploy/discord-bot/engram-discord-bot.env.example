# --- Secrets ---------------------------------------------------------------
DISCORD_TOKEN=
ANTHROPIC_API_KEY=
# GitHub App (preferred). Put the app's private key next to docker-compose.yml
# as github-app.pem; the compose file mounts it. The container runs as UID/GID 10001,
# so make the key group-readable by it or the bot crash-loops on PermissionError:
#   sudo chown $USER:10001 github-app.pem && chmod 640 github-app.pem
GITHUB_APP_ID=
# Or, instead of an app, a fine-grained token with Issues: read & write on the repo
# (plus Contents: read-only if that repo is private):
# GITHUB_TOKEN=

# --- Discord wiring (enable Developer Mode, right-click -> Copy ID) ---------
# The bot answers only in this server; mentions and commands from others are ignored.
DISCORD_GUILD_ID=
DISCORD_HELP_FORUM_ID=
DISCORD_MAINTAINER_ROLE_ID=
# Optional: a private channel that gets a line for every issue the bot files.
DISCORD_MAINTAINER_LOG_CHANNEL_ID=
# How the bot refers to you ("the maintainer" if unset).
MAINTAINER_NAME=

# --- Optional tuning (defaults shown) --------------------------------------
# Where issues are filed (point at a scratch repo to test):
# GITHUB_REPO=Jsakkos/engram
# Where docs, the changelog and release notices come from:
# BOT_DOCS_REPO=Jsakkos/engram
# BOT_MODEL=claude-haiku-5-5
# BOT_EFFORT=medium
# BOT_DAILY_BUDGET_USD=2.0
# BOT_MAX_ISSUES_PER_USER_PER_DAY=3
# BOT_MAX_TURNS_PER_USER_PER_HOUR=30
# BOT_MIN_ACCOUNT_AGE_DAYS=7
# BOT_ALLOWED_LABELS=bug,enhancement,documentation,ux,question,linux,docker
# BOT_KNOWLEDGE_REFRESH_HOURS=6
# BOT_GITHUB_POLL_MINUTES=10
# Answer long or downvoted threads with a stronger model (off when unset):
# BOT_ESCALATION_MODEL=claude-sonnet-5-5
# BOT_ESCALATION_AFTER_TURNS=6
# Weekly digest in the maintainer log channel (0 = Monday):
# BOT_DIGEST_WEEKDAY=0
# BOT_DIGEST_HOUR_UTC=9
# LOG_LEVEL=INFO

# Copy to ~/.config/engram/subtitle-cache.env on the harvest server and fill in.
#
#   install -d -m 700 ~/.config/engram
#   install -m 600 /dev/null ~/.config/engram/subtitle-cache.env
#   ${EDITOR:-nano} ~/.config/engram/subtitle-cache.env
#
# systemd EnvironmentFile syntax: KEY=value, no `export`, no shell quoting or
# expansion. A value containing '#' or spaces is taken literally to end of line.
#
# Use LF line endings, not CRLF, and leave no trailing whitespace after a
# value: the parser takes everything after '=' to end of line, so a stray
# '\r' (from a file edited on or copied from Windows) or a trailing space is
# silently appended to the token or password. The result is an opaque auth
# failure at 02:00 with nobody watching, and the FATAL line ("gh is not
# authenticated", or an OpenSubtitles 401) gives no hint that the credential
# text itself is the problem. If a credential that looks correct is rejected,
# verify with `cat -A ~/.config/engram/subtitle-cache.env` (a real CRLF line
# shows a trailing `^M$`; trailing whitespace shows as extra space before `$`).
#
# This file is never committed and its contents are never pasted into a
# terminal transcript, an issue, or a chat session.

# TMDB v4 Read Access Token (the long eyJ... JWT, not the short v3 API key).
TMDB_API_KEY=

# OpenSubtitles.com API consumer key (identifies the app).
OPENSUBTITLES_API_KEY=

# OpenSubtitles.com VIP account login (carries the 1000/day download quota).
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Optional overrides read by harvest.sh (values shown are the built-in defaults):
# ENGRAM_REPO=$HOME/engram
# ENGRAM_REPO_SLUG=Jsakkos/engram
# ENGRAM_SHOW_LIST=$ENGRAM_REPO/backend/scripts/curated_shows.csv
# ENGRAM_MAX_DOWNLOADS=900
# ENGRAM_CACHE_TAG=subtitle-cache-latest
# ENGRAM_WORK_DIR=$HOME/.engram/harvest
# ENGRAM_MIN_FREE_KB=1048576
# ENGRAM_UPLOAD_ATTEMPTS=3
# ENGRAM_UPLOAD_BACKOFF=30
